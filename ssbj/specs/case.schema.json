        "wing",
        "fuselage",
        "fin",
        "nacelles",
        "engine",
        "weights"
      ],
      "title": "Design",
      "type": "object"
    },
    "Engine": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "ab_turbojet",
          "default": "ab_turbojet",
          "title": "Type",
          "type": "string"
        },
        "count": {
          "maximum": 8,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "fn_sls_dry_kN": {
          "description": "dry SLS thrust per engine at the design point",
          "exclusiveMinimum": 0,
          "title": "Fn Sls Dry Kn",
          "type": "number"
        },
        "opr": {
          "exclusiveMaximum": 60,
          "exclusiveMinimum": 2,
          "title": "Opr",
          "type": "number"
        },
        "t4_max_K": {
          "exclusiveMaximum": 2200,
          "exclusiveMinimum": 1000,
          "title": "T4 Max K",
          "type": "number"
        },
        "t_ab_K": {
          "description": "afterburner exit temperature at full reheat",
          "exclusiveMaximum": 2400,
          "exclusiveMinimum": 1200,
          "title": "T Ab K",
          "type": "number"
        },
        "comp_eff": {
          "default": 0.85,
          "exclusiveMaximum": 0.95,
          "exclusiveMinimum": 0.6,
          "title": "Comp Eff",
          "type": "number"
        },
        "turb_eff": {
          "default": 0.88,
          "exclusiveMaximum": 0.96,
          "exclusiveMinimum": 0.6,
          "title": "Turb Eff",
          "type": "number"
        },
        "nozzle_cv": {
          "default": 0.99,
          "exclusiveMinimum": 0.9,
          "maximum": 1.0,
          "title": "Nozzle Cv",
          "type": "number"
        },
        "customer_bleed_fraction": {
          "default": 0.0,
          "exclusiveMaximum": 0.1,
          "minimum": 0,
          "title": "Customer Bleed Fraction",
          "type": "number"
        }
      },
      "required": [
        "count",
        "fn_sls_dry_kN",
        "opr",
        "t4_max_K",
        "t_ab_K"
      ],
      "title": "Engine",
      "type": "object"
    },
    "FinSpec": {
      "additionalProperties": false,
