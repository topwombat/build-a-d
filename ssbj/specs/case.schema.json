{
  "$defs": {
    "Climb": {
      "additionalProperties": false,
      "description": "Climb and/or accelerate along a straight line in (Mach, altitude) to the end point.\n\nIntegrated in energy height: each step uses specific excess power at the\nselected power setting. ``power: max_reheat`` is the transonic acceleration.",
      "properties": {
        "segment": {
          "const": "climb",
          "title": "Segment",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "to_mach": {
          "exclusiveMinimum": 0,
          "maximum": 3,
          "title": "To Mach",
          "type": "number"
        },
        "to_altitude_ft": {
          "maximum": 70000,
          "minimum": 0,
          "title": "To Altitude Ft",
          "type": "number"
        },
        "power": {
          "enum": [
            "max_dry",
            "max_reheat"
          ],
          "title": "Power",
          "type": "string"
        }
      },
      "required": [
        "segment",
        "name",
        "to_mach",
        "to_altitude_ft",
        "power"
      ],
      "title": "Climb",
      "type": "object"
    },
    "CruiseSpec": {
      "additionalProperties": false,
      "properties": {
        "mach": {
          "exclusiveMinimum": 0,
          "maximum": 3,
          "title": "Mach",
          "type": "number"
        },
        "altitude_min_ft": {
          "maximum": 70000,
          "minimum": 0,
          "title": "Altitude Min Ft",
          "type": "number"
        },
        "altitude_max_ft": {
          "maximum": 70000,
          "minimum": 0,
          "title": "Altitude Max Ft",
          "type": "number"
        },
        "mode": {
          "default": "cruise_climb",
          "enum": [
            "cruise_climb",
            "constant_altitude"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mach",
        "altitude_min_ft",
        "altitude_max_ft"
      ],
      "title": "CruiseSpec",
      "type": "object"
    },
    "Descent": {
      "additionalProperties": false,
      "properties": {
        "segment": {
          "const": "descent",
          "title": "Segment",
          "type": "string"
        },
        "name": {
          "default": "descent",
          "title": "Name",
          "type": "string"
        },
        "to_altitude_ft": {
          "default": 0.0,
          "minimum": 0,
          "title": "To Altitude Ft",
          "type": "number"
        },
        "to_mach": {
          "default": 0.3,
          "exclusiveMinimum": 0,
          "title": "To Mach",
          "type": "number"
        },
        "lift_to_drag_glide": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "if omitted, the aero polar at idle is used",
          "title": "Lift To Drag Glide"
        }
      },
      "required": [
        "segment"
      ],
      "title": "Descent",
      "type": "object"
    },
    "Design": {
      "additionalProperties": false,
      "properties": {
        "wing": {
          "$ref": "#/$defs/Wing"
        },
        "fuselage": {
          "$ref": "#/$defs/Fuselage"
        },
        "fin": {
          "$ref": "#/$defs/FinSpec"
        },
        "nacelles": {
          "$ref": "#/$defs/NacelleSpec"
        },
        "engine": {
          "$ref": "#/$defs/Engine"
        },
        "weights": {
          "$ref": "#/$defs/WeightsInputs"
        }
