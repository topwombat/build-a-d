        },
        "sonic_boom": {
          "default": "report",
          "enum": [
            "report",
            "constrain"
          ],
          "title": "Sonic Boom",
          "type": "string"
        },
        "profile": {
          "items": {
            "discriminator": {
              "mapping": {
                "climb": "#/$defs/Climb",
                "cruise": "#/$defs/RangeCruise",
                "cruise_fixed": "#/$defs/FixedCruise",
                "descent": "#/$defs/Descent",
                "takeoff": "#/$defs/Takeoff",
                "taxi": "#/$defs/Taxi"
              },
              "propertyName": "segment"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Taxi"
              },
              {
                "$ref": "#/$defs/Takeoff"
              },
              {
                "$ref": "#/$defs/Climb"
              },
              {
                "$ref": "#/$defs/FixedCruise"
              },
              {
                "$ref": "#/$defs/RangeCruise"
              },
              {
                "$ref": "#/$defs/Descent"
              }
            ]
          },
          "title": "Profile",
          "type": "array"
        }
      },
      "required": [
        "payload",
        "design_range_nmi",
        "cruise",
        "reserves",
        "profile"
