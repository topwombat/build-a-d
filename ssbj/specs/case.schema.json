    "Mission": {
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/Payload"
        },
        "design_range_nmi": {
          "description": "trip distance for the fuel-burn evaluation",
          "exclusiveMinimum": 0,
          "title": "Design Range Nmi",
          "type": "number"
        },
        "cruise": {
          "$ref": "#/$defs/CruiseSpec"
        },
        "reserves": {
          "$ref": "#/$defs/Reserves"
        },
        "field_length_ft": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "reported in Phase 4; not evaluated yet",
          "title": "Field Length Ft"
        },
        "takeoff_noise": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
